# Loaded by `npm test` through node --env-file (works on every OS shell, unlike VAR=x prefixes).
# Polling instead of fs.watch keeps parallel test servers from exhausting the inotify instance limit.
# Test only: see server/workspace/poll-watch.js.
DRAW_WORKSPACE_WATCH=poll
# Keeps ~/.dispatch/drawing.json (the user's defaults) out of every test; test/user-defaults.test.js uses a temp HOME.
DRAWING_USER_DEFAULTS=off
